---
import { contact, socials, site, services } from '../data/site';
const cols = [
  { title: 'Explore', links: [{ href: '/weddings/', label: 'Weddings' }, { href: '/gallery/', label: 'Gallery' }, { href: '/pricing/', label: 'Pricing' }, { href: '/reviews/', label: 'Reviews' }, { href: '/vendors/', label: 'Vendors' }, { href: '/about/', label: 'About' }, { href: '/process/', label: 'Process' }, { href: '/book/', label: 'Book a Consultation' }, { href: '/our-team/', label: 'Our Team' }, { href: '/services/', label: 'Services' }, { href: '/blog/', label: 'The Blog' }, { href: '/faq/', label: 'FAQ' }, { href: '/work-with-us/', label: 'Work With Us' }] },
  { title: 'Services', links: services.map((s) => ({ href: `/services/${s.slug}/`, label: s.title, price: s.price })) },
  { title: 'Support', links: [{ href: '/contact/', label: 'Contact Us' }, { href: '/search/', label: 'Search' }, { href: '/privacy/', label: 'Privacy Policy' }, { href: '/terms/', label: 'Terms of Service' }] },
];
// Inline stroke icons (24x24 grid, 2px stroke, round caps/joins) —
// drawn here, never hotlinked. The aria-label on the link names the network.
const icons: Record<string, string> = {
  Instagram: '<rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />',
  Pinterest: '<path d="M10.5 20c.7-2.6 1.5-5.6 1.9-8" /><path d="M12.6 12.6c-.3 1.1-1.3 1.9-2.6 1.9-1.7 0-2.9-1.4-2.9-3.2 0-2.2 1.8-4 4.3-4 2.3 0 4 1.5 4 3.7 0 2.6-1.8 4.3-4 4.3-1 0-1.8-.4-2.1-1" />',
  Facebook: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />',
  TikTok: '<path d="M9 17.5a3 3 0 1 0 3-3V4" /><path d="M15 5.5c.7 2 2.1 3.4 4 3.8" />',
};
---
<footer class="bg-terra px-4 pb-6 pt-12 text-white sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-10 border-b border-white/20 pb-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <a href="/" class="text-center leading-none md:text-left">
          <span class="block font-display text-2xl font-semibold uppercase tracking-[0.08em]">Whatever</span>
          <span class="my-0.5 block"><span class="font-script text-xl leading-none">is</span> <span class="font-display text-2xl font-semibold uppercase tracking-[0.08em]">Lovely</span></span>
          <span class="block text-[9px] font-semibold uppercase tracking-[0.42em] text-white/90">Weddings + Events</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-white/80">Personalized wedding planning for couples livin' it up in KCMO — since 2016.</p>
        <p class="mt-4 text-sm font-semibold"><a href={`mailto:${contact.email}`} class="underline decoration-white/40 underline-offset-2 transition hover:text-white hover:decoration-white">{contact.email}</a></p>
        <p class="text-sm font-semibold"><a href={contact.phoneHref} class="underline decoration-white/40 underline-offset-2 transition hover:text-white hover:decoration-white">{contact.phoneDisplay}</a></p>
        <p class="mt-1 text-xs text-white/70">{contact.location} · {contact.hours}</p>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {cols.map((c) => (
          <div>
            <h3 class="font-display text-sm font-bold uppercase tracking-wider">{c.title}</h3>
            <ul class="mt-3 space-y-3 text-sm">
              {c.links.map((l) => (
                <li>
                  <a href={l.href} class="text-white/80 transition hover:text-white hover:underline">{l.label}</a>
                  {'price' in l && l.price && <span class="block text-xs text-white/60">{l.price}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="max-w-xs">
        <h3 class="font-display text-sm font-bold uppercase tracking-wider">Wedding wisdom, monthly</h3>
        <p class="mt-3 text-sm text-white/80">Planning tips and real weddings, once a month. No spam.</p>
        <form id="newsletter-form" novalidate class="mt-3 flex overflow-hidden rounded-full border border-white/30 bg-white/10">
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input id="newsletter-email" type="email" required placeholder="Enter your email" aria-describedby="newsletter-email-error" class="w-full bg-transparent px-4 py-2.5 text-sm text-white outline-none placeholder:text-white/60" />
          <button type="submit" class="shrink-0 bg-gold px-4 text-sm font-semibold text-ink transition hover:bg-white hover:text-terra">Join</button>
        </form>
        <p id="newsletter-email-error" class="field-error invisible text-red-200" role="alert"></p>
        <p id="newsletter-ok" class="mt-2 hidden text-sm font-semibold">Thanks — you're on the list. <span class="font-normal text-white/70">(Demo: saved only in this browser, not sent anywhere.)</span></p>
      </div>
    </div>
    <div class="flex flex-col items-center justify-between gap-4 pt-6 sm:flex-row">
      <p class="text-xs text-white/70">© {site.year} Whatever is Lovely. All rights reserved. · Kansas City, MO</p>
      <div class="flex items-center gap-2">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={`${s.label} — Whatever is Lovely (mock handle)`} class="grid h-11 w-11 place-items-center rounded-full border border-white/30 text-white transition hover:bg-white hover:text-terra">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.label] ?? ''} />
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

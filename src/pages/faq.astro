---
import Layout from '../layouts/Layout.astro';
import { faqs } from '../data/site';
---
<Layout title="FAQ — Whatever is Lovely | Kansas City Wedding Planning">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="reveal text-center text-xs font-bold uppercase tracking-[0.35em] text-gold">FAQ</p>
    <h1 data-split class="mt-2 text-center font-display text-5xl font-semibold uppercase text-terra sm:text-6xl">Questions, answered</h1>
    <p class="reveal mx-auto mt-4 max-w-xl text-center leading-relaxed text-ink-soft">Everything couples usually ask us before they book. Something else on your mind? <a href="/work-with-us/" class="font-semibold text-terra underline">Ask us directly</a>.</p>
    <div class="mt-10 space-y-3">
      {faqs.map((f, i) => (
        <div class="reveal rounded-2xl border border-line bg-white">
          <button type="button" data-faq-btn aria-expanded={i === 0 ? 'true' : 'false'} class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left font-display text-lg font-semibold text-terra">
            {f.q}<span class="faq-icon shrink-0 text-2xl font-light text-gold" aria-hidden="true">+</span>
          </button>
          <div class="faq-panel" data-open={i === 0 ? 'true' : 'false'}><div><p class="px-5 pb-5 text-sm leading-relaxed text-ink-soft">{f.a}</p></div></div>
        </div>
      ))}
    </div>
  </section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import StickyBar from '../../components/StickyBar.astro';
import { contact, site } from '../../data/site';
---
<Layout
  title="Contact — Whatever is Lovely | Kansas City Wedding Planning"
  description="Contact Whatever is Lovely, a Kansas City wedding planning studio — call, email, or send a message. Studio hours Mon–Fri 9am–5pm CT, Saturdays by appointment."
  ogImage="https://whatever-is-lovely.pages.dev/images/venue-loft-1200.jpg"
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="reveal text-center text-xs font-bold uppercase tracking-[0.35em] text-gold-text">Contact</p>
    <h1 data-split class="mt-2 text-center font-display text-5xl font-semibold uppercase text-terra sm:text-6xl">Let's talk weddings</h1>
    <p class="reveal mx-auto mt-4 max-w-2xl text-center leading-relaxed text-ink-soft">Call, email, or send a message below — we reply within one business day. Prefer to book straight in? <a href="/book/" class="font-bold text-terra underline">Book a free consultation</a>.</p>

    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      <div>
        <div class="reveal">
          <Picture name="venue-loft" alt="The Downtown Loft wedding venue in Kansas City" sizes="(max-width: 768px) 100vw, 560px" imgClass="aspect-[4/3] w-full rounded-2xl object-cover shadow-md" />
        </div>
        <!-- Map placeholder: a styled block, NOT a fake map embed. -->
        <div class="reveal mt-6 overflow-hidden rounded-2xl border border-line bg-cream-2" role="img" aria-label="Map placeholder: our studio is in Kansas City, Missouri. Use the address links below for directions.">
          <div class="relative grid h-56 place-items-center bg-[linear-gradient(135deg,#f3e7d7_0%,#e9d8bf_50%,#f3e7d7_100%)]">
            <div class="absolute inset-0 opacity-30" style="background-image: linear-gradient(#b9973f33 1px, transparent 1px), linear-gradient(90deg, #b9973f33 1px, transparent 1px); background-size: 48px 48px;"></div>
            <div class="relative text-center">
              <p class="font-display text-5xl text-terra" aria-hidden="true">✦</p>
              <p class="mt-1 font-display text-2xl font-semibold text-terra">Kansas City, MO</p>
              <p class="text-sm text-ink-soft">Our studio · by appointment</p>
            </div>
          </div>
          <p class="px-5 py-3 text-center text-xs text-ink-soft/70">Map coming soon — for directions, search “Whatever is Lovely, Kansas City MO” in your maps app.</p>
        </div>
        <dl class="reveal mt-6 space-y-3 rounded-2xl border border-line bg-white p-6 text-sm shadow-sm">
          <div class="flex gap-3"><dt class="w-20 shrink-0 font-bold uppercase tracking-wider text-gold-text">Phone</dt><dd><a href={contact.phoneHref} class="font-semibold text-terra underline">{contact.phoneDisplay}</a></dd></div>
          <div class="flex gap-3"><dt class="w-20 shrink-0 font-bold uppercase tracking-wider text-gold-text">Email</dt><dd><a href={`mailto:${contact.email}`} class="font-semibold text-terra underline">{contact.email}</a></dd></div>
          <div class="flex gap-3"><dt class="w-20 shrink-0 font-bold uppercase tracking-wider text-gold-text">Hours</dt><dd>{contact.hours}</dd></div>
          <div class="flex gap-3"><dt class="w-20 shrink-0 font-bold uppercase tracking-wider text-gold-text">Studio</dt><dd>{contact.location} · {site.est}</dd></div>
        </dl>
      </div>

      <div class="reveal h-fit rounded-2xl border border-line bg-white p-7 shadow-sm sm:p-9">
        <h2 class="font-display text-3xl font-semibold text-terra">Send us a message</h2>
        <p class="mt-1 text-sm text-ink-soft">Demo form — your message is saved in this browser only; nothing is emailed.</p>
        <form id="contact-form" novalidate class="mt-6 space-y-5">
          <div>
            <label for="ct-name" class="text-sm font-bold text-terra">Your names *</label>
            <input id="ct-name" type="text" autocomplete="name" required placeholder="Emma & James" aria-describedby="ct-name-error" class="mt-1 w-full rounded-xl border border-line bg-cream px-4 py-3 outline-none placeholder:text-ink-soft/50 focus:border-terra" />
            <p id="ct-name-error" class="field-error invisible text-red-700" role="alert"></p>
          </div>
          <div>
            <label for="ct-email" class="text-sm font-bold text-terra">Email *</label>
            <input id="ct-email" type="email" autocomplete="email" required placeholder="you@example.com" aria-describedby="ct-email-error" class="mt-1 w-full rounded-xl border border-line bg-cream px-4 py-3 outline-none placeholder:text-ink-soft/50 focus:border-terra" />
            <p id="ct-email-error" class="field-error invisible text-red-700" role="alert"></p>
          </div>
          <div>
            <label for="ct-subject" class="text-sm font-bold text-terra">What is this about? *</label>
            <select id="ct-subject" required aria-describedby="ct-subject-error" class="mt-1 w-full rounded-xl border border-line bg-cream px-4 py-3 outline-none focus:border-terra">
              <option value="">Choose a topic…</option>
              <option value="A wedding I'm planning">A wedding I'm planning</option>
              <option value="Pricing question">Pricing question</option>
              <option value="Availability check">Availability check</option>
              <option value="Something else">Something else</option>
            </select>
            <p id="ct-subject-error" class="field-error invisible text-red-700" role="alert"></p>
          </div>
          <div>
            <label for="ct-message" class="text-sm font-bold text-terra">Your message *</label>
            <textarea id="ct-message" rows="5" required placeholder="Tell us a little about your wedding…" aria-describedby="ct-message-error" class="mt-1 w-full rounded-xl border border-line bg-cream px-4 py-3 outline-none placeholder:text-ink-soft/50 focus:border-terra"></textarea>
            <p id="ct-message-error" class="field-error invisible text-red-700" role="alert"></p>
          </div>
          <button type="submit" class="w-full rounded-sm bg-gold px-7 py-4 text-sm font-bold uppercase tracking-[0.18em] text-ink transition hover:bg-terra hover:text-white">Send Message</button>
          <div id="contact-form-ok" class="hidden rounded-xl bg-cream-2 px-5 py-4" role="status" aria-live="polite">
            <p class="font-display text-xl font-semibold text-terra">Thank you — message received!</p>
            <p class="mt-1 text-sm">Your reference code is <strong id="ct-ref" class="text-terra">WL-······</strong> — keep it handy when you talk to us.</p>
            <p id="ct-summary" class="mt-2 text-sm text-ink-soft"></p>
            <p class="mt-3 text-sm leading-relaxed"><strong class="text-terra">What happens next:</strong> we will reply within one business day. For the fastest answer, <a href="/book/" class="font-bold underline">book a free consultation</a> instead.</p>
            <p class="mt-2 text-xs text-ink-soft/70">Demo form — saved only in this browser (localStorage), nothing was emailed.</p>
          </div>
        </form>
      </div>
    </div>
  </section>
  <StickyBar />
</Layout>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const setErr = (id: string, msg: string) => {
    const e = document.getElementById(id);
    if (e) { e.textContent = msg; e.classList.remove('invisible'); }
  };
  const clearErr = (id: string) => {
    const e = document.getElementById(id);
    if (e) { e.textContent = ''; e.classList.add('invisible'); }
  };
  const fieldErr = (input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement, msg: string) => {
    const err = document.getElementById(`${input.id}-error`);
    if (err) { err.textContent = msg; err.classList.remove('invisible'); }
    input.setAttribute('aria-invalid', 'true');
  };
  const fieldClear = (input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
    const err = document.getElementById(`${input.id}-error`);
    if (err) { err.textContent = ''; err.classList.add('invisible'); }
    input.removeAttribute('aria-invalid');
  };
  if (form) {
    const name = document.getElementById('ct-name') as HTMLInputElement;
    const email = document.getElementById('ct-email') as HTMLInputElement;
    const subject = document.getElementById('ct-subject') as HTMLSelectElement;
    const msg = document.getElementById('ct-message') as HTMLTextAreaElement;
    name.addEventListener('blur', () => { if (name.value.trim().length < 2) fieldErr(name, 'Please enter your names.'); else fieldClear(name); });
    email.addEventListener('blur', () => { if (!emailRe.test(email.value.trim())) fieldErr(email, 'Please enter a valid email address.'); else fieldClear(email); });
    subject.addEventListener('change', () => { if (!subject.value) fieldErr(subject, 'Please choose a topic.'); else fieldClear(subject); });
    msg.addEventListener('blur', () => { if (msg.value.trim().length < 10) fieldErr(msg, 'Please tell us a little more (at least 10 characters).'); else fieldClear(msg); });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let ok = true;
      if (name.value.trim().length < 2) { fieldErr(name, 'Please enter your names.'); ok = false; } else fieldClear(name);
      if (!emailRe.test(email.value.trim())) { fieldErr(email, 'Please enter a valid email address.'); ok = false; } else fieldClear(email);
      if (!subject.value) { fieldErr(subject, 'Please choose a topic.'); ok = false; } else fieldClear(subject);
      if (msg.value.trim().length < 10) { fieldErr(msg, 'Please tell us a little more (at least 10 characters).'); ok = false; } else fieldClear(msg);
      if (!ok) { (document.querySelector('[aria-invalid="true"]') as HTMLElement)?.focus(); return; }
      const ref = 'WL-' + Array.from({ length: 6 }, () => 'ABCDEFGHJKMNPQRSTUVWXYZ23456789'[Math.floor(Math.random() * 31)]).join('');
      try {
        const prev = JSON.parse(localStorage.getItem('wil-enquiries') ?? '[]') as unknown[];
        prev.push({ ref, name: name.value.trim(), email: email.value.trim(), subject: subject.value, message: msg.value.trim(), submittedAt: new Date().toISOString() });
        localStorage.setItem('wil-enquiries', JSON.stringify(prev));
      } catch { /* private mode */ }
      const refEl = document.getElementById('ct-ref');
      if (refEl) refEl.textContent = ref;
      const sum = document.getElementById('ct-summary');
      if (sum) sum.textContent = `${name.value.trim()} · ${email.value.trim()} · ${subject.value}`;
      document.getElementById('contact-form-ok')?.classList.remove('hidden');
      document.getElementById('contact-form-ok')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      form.reset();
    });
  }
</script>

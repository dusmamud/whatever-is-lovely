---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import { team, stats } from '../data/site';
---
<Layout title="Our Team — Whatever is Lovely | Kansas City Wedding Planners">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="reveal text-center text-xs font-bold uppercase tracking-[0.35em] text-gold-text">Our Team</p>
    <h1 data-split class="mt-2 text-center font-display text-5xl font-semibold uppercase text-terra sm:text-6xl">The women behind the lovely</h1>
    <p class="reveal mx-auto mt-4 max-w-2xl text-center leading-relaxed text-ink-soft">A small, senior team — no juniors learning on your wedding. Since 2016 we've planned hundreds of Kansas City celebrations, and we still get excited about every single one.</p>
    <div class="mt-12 grid gap-10 sm:grid-cols-3">
      {team.map((m) => (
        <article class="reveal text-center">
          <Picture name={m.img.replace('/images/', '').replace(/-\d+\.jpg$/, '')} alt={m.name} sizes="(max-width: 768px) 100vw, 380px" imgClass="mx-auto aspect-square w-64 rounded-full object-cover shadow-md" />
          <h2 class="mt-5 font-display text-3xl font-semibold text-terra">{m.name}</h2>
          <p class="text-xs font-bold uppercase tracking-wider text-gold-text">{m.role}</p>
          <p class="mx-auto mt-3 max-w-xs leading-relaxed text-ink-soft">{m.bio}</p>
        </article>
      ))}
    </div>
    <div class="reveal mt-14 grid grid-cols-2 gap-6 rounded-2xl bg-terra p-8 text-center text-white sm:grid-cols-4">
      {stats.map((s) => (
        <div>
          <p class="font-display text-4xl font-bold"><span data-count={s.value}>0</span>{s.suffix}</p>
          <p class="mt-1 text-xs font-bold uppercase tracking-wider text-white/85">{s.label}</p>
          <p class="text-xs text-white/70">{s.sub}</p>
        </div>
      ))}
    </div>
    <div class="reveal mt-12 text-center">
      <p class="font-script text-5xl text-terra">we can't wait to meet you</p>
      <a href="/work-with-us/" class="mt-5 inline-block rounded-sm bg-gold px-8 py-4 text-sm font-bold uppercase tracking-[0.18em] text-ink transition hover:bg-terra hover:text-white">Work With Us</a>
    </div>
  </section>
</Layout>

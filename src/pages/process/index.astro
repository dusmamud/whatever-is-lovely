---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import StickyBar from '../../components/StickyBar.astro';
import { processSteps, services, site } from '../../data/site';
const stepImages = ['couple-portrait-2', 'decor-florals', 'table-setting', 'couple-exit'];
---
<Layout
  title="Our Process — Whatever is Lovely | Kansas City Wedding Planning"
  description="How planning with Whatever is Lovely works — from the first hello to the last dance. Four steps, one calm plan, zero surprises."
  ogImage="https://whatever-is-lovely.pages.dev/images/decor-florals-1200.jpg"
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="reveal text-center text-xs font-bold uppercase tracking-[0.35em] text-gold-text">Our Process</p>
    <h1 data-split class="mt-2 text-center font-display text-5xl font-semibold uppercase text-terra sm:text-6xl">From hello to happily ever after</h1>
    <p class="reveal mx-auto mt-4 max-w-2xl text-center leading-relaxed text-ink-soft">Four steps, one calm plan. Here is exactly what happens when you plan your Kansas City wedding with us — and when.</p>

    <ol class="relative mt-14 space-y-10 before:absolute before:bottom-4 before:left-[27px] before:top-4 before:w-px before:bg-line sm:before:left-[31px]">
      {processSteps.map((st, i) => (
        <li class="reveal relative grid gap-5 pl-20 sm:pl-24 md:grid-cols-[1fr_320px] md:gap-8">
          <span class="absolute left-0 top-0 grid h-14 w-14 place-items-center rounded-full bg-terra font-display text-2xl font-bold text-white shadow-md sm:h-16 sm:w-16" aria-hidden="true">{st.num}</span>
          <div class="rounded-2xl border border-line bg-white p-7 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-gold-text">{st.weeks}</p>
            <h2 class="mt-1 font-display text-3xl font-semibold text-terra">{st.title}</h2>
            <p class="mt-2 font-semibold text-ink">{st.short}</p>
            <p class="mt-2 leading-relaxed text-ink-soft">{st.detail}</p>
          </div>
          <Picture name={stepImages[i]} alt={`${st.title} — wedding planning step ${st.num}`} sizes="(max-width: 768px) 100vw, 320px" imgClass="aspect-[4/3] w-full rounded-2xl object-cover shadow-md" />
        </li>
      ))}
    </ol>

    <div class="reveal mt-14 rounded-2xl bg-terra p-8 text-center text-white sm:p-10">
      <p class="font-script text-5xl">wherever you are, we meet you there</p>
      <p class="mx-auto mt-3 max-w-xl leading-relaxed text-white/85">Already booked your venue? Halfway through planning? Every package picks up wherever you are — full service, partial planning or day-of coordination.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="min-h-[48px] rounded-sm bg-gold px-6 py-3.5 text-sm font-bold uppercase tracking-[0.18em] text-ink transition hover:bg-white">{s.title}</a>
        ))}
      </div>
      <a href="/book/" class="mt-6 inline-block rounded-sm border border-white px-8 py-4 text-sm font-bold uppercase tracking-[0.18em] text-white transition hover:bg-white hover:text-terra">Start With Step One — Book a Free Consultation</a>
      <p class="mt-3 text-xs text-white/70">Booking {site.bookingYear} weddings now · No obligation, no pressure.</p>
    </div>
  </section>
  <StickyBar />
</Layout>

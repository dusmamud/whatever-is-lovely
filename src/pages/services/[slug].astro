---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import { services, serviceDetails } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug } }));
}
const { slug } = Astro.params;
const service = services.find((s) => s.slug === slug)!;
const detail = serviceDetails[slug as keyof typeof serviceDetails];
const others = services.filter((s) => s.slug !== slug);
---
<Layout title={`${service.title} — Whatever is Lovely | Kansas City Wedding Planning`} description={service.short}>
  <section class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
    <p class="reveal text-xs font-bold uppercase tracking-[0.35em] text-gold">Service {service.num} · {service.price}</p>
    <h1 data-split class="mt-2 font-display text-5xl font-semibold uppercase text-terra sm:text-6xl">{service.title}</h1>
    <p class="reveal mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{detail.intro}</p>
    <div class="reveal mt-6 flex flex-wrap justify-center gap-4 text-sm">
      <span class="rounded-full bg-white px-4 py-2 font-semibold text-terra shadow-sm">Best for: {detail.bestFor}</span>
      <span class="rounded-full bg-white px-4 py-2 font-semibold text-terra shadow-sm">When to book: {detail.timeline}</span>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="reveal">
        <Picture name="garden-couple" alt="Bride and groom embracing in a garden" sizes="(max-width: 768px) 100vw, 560px" imgClass="aspect-[4/3] w-full rounded-2xl object-cover shadow-md" />
      </div>
      <div class="reveal rounded-2xl border border-line bg-white p-8 shadow-sm">
        <h2 class="font-display text-3xl font-semibold text-terra">What's included</h2>
        <ul class="mt-4 space-y-3 text-ink-soft">
          {detail.includes.map((i) => (<li class="flex gap-3"><span aria-hidden="true" class="text-gold">✦</span>{i}</li>))}
        </ul>
        <p class="mt-6 font-display text-2xl font-bold text-terra">{service.price}</p>
        <a href="/work-with-us/" class="mt-4 inline-block rounded-sm bg-gold px-7 py-3.5 text-sm font-bold uppercase tracking-[0.18em] text-white transition hover:bg-gold-deep">Check Your Date</a>
      </div>
    </div>
    <h2 class="reveal mt-14 text-center font-display text-3xl font-semibold uppercase text-terra">Other ways we can help</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {others.map((o) => (
        <a href={`/services/${o.slug}/`} class="reveal block rounded-2xl border border-line bg-white p-6 shadow-sm transition hover:border-gold">
          <p class="text-xs font-bold uppercase tracking-wider text-gold">{o.price}</p>
          <h3 class="mt-1 font-display text-2xl font-semibold text-terra">{o.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-soft">{o.short}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

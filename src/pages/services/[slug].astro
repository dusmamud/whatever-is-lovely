---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import StickyBar from '../../components/StickyBar.astro';
import { services, serviceDetails, site } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug } }));
}
const { slug } = Astro.params;
const service = services.find((s) => s.slug === slug)!;
const detail = serviceDetails[slug as keyof typeof serviceDetails];
const others = services.filter((s) => s.slug !== slug);
// Distinct hero image per service — no more garden-couple everywhere.
const heroImgs: Record<string, { name: string; alt: string }> = {
  'full-service-planning': { name: 'venue-garden', alt: 'Garden venue with floral arch and golden-hour lawns' },
  'partial-planning': { name: 'decor-florals', alt: 'Blush rose table florals and styling details' },
  'day-of-coordination': { name: 'reception-candles', alt: 'Candlelit wedding reception ready for the first dance' },
};
const hero = heroImgs[service.slug] ?? { name: 'garden-couple', alt: service.title };
---
<Layout
  title={`${service.title} — Whatever is Lovely | Kansas City Wedding Planning`}
  description={service.short}
  ogImage={`${site.url}/images/${hero.name}-1200.jpg`}
>
  <section class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
    <p class="reveal text-xs font-bold uppercase tracking-[0.35em] text-gold-text">Service {service.num} · {service.price}</p>
    <h1 data-split class="mt-2 font-display text-5xl font-semibold uppercase text-terra sm:text-6xl">{service.title}</h1>
    <p class="reveal mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{detail.intro}</p>
    <div class="reveal mt-6 flex flex-wrap justify-center gap-4 text-sm">
      <span class="rounded-full bg-white px-4 py-2 font-semibold text-terra shadow-sm">Best for: {detail.bestFor}</span>
      <span class="rounded-full bg-white px-4 py-2 font-semibold text-terra shadow-sm">When to book: {detail.timeline}</span>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="reveal">
        <Picture name={hero.name} alt={hero.alt} eager sizes="(max-width: 768px) 100vw, 560px" imgClass="aspect-[4/3] w-full rounded-2xl object-cover shadow-md" />
      </div>
      <div class="reveal rounded-2xl border border-line bg-white p-8 shadow-sm">
        <h2 class="font-display text-3xl font-semibold text-terra">What's included</h2>
        <ul class="mt-4 space-y-3 text-ink-soft">
          {detail.includes.map((i) => (<li class="flex gap-3"><span aria-hidden="true" class="text-gold-text">✦</span>{i}</li>))}
        </ul>
        <p class="mt-6 font-display text-2xl font-bold text-terra">{service.price}</p>
        <a href={`/book/?service=${service.slug}`} class="mt-4 inline-block rounded-sm bg-gold px-7 py-3.5 text-sm font-bold uppercase tracking-[0.18em] text-ink transition hover:bg-terra hover:text-white">Check Your Date</a>
        <p class="mt-3 text-sm text-ink-soft">Free 20-minute consultation · Booking {site.bookingYear} weddings now.</p>
      </div>
    </div>
    <h2 class="reveal mt-14 text-center font-display text-3xl font-semibold uppercase text-terra">Other ways we can help</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {others.map((o) => (
        <a href={`/services/${o.slug}/`} class="reveal block rounded-2xl border border-line bg-white p-6 shadow-sm hover:border-gold">
          <p class="text-xs font-bold uppercase tracking-wider text-gold-text">{o.price}</p>
          <h3 class="mt-1 font-display text-2xl font-semibold text-terra">{o.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-soft">{o.short}</p>
        </a>
      ))}
    </div>
    <p class="reveal mt-10 text-center"><a href="/pricing/" class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-terra transition hover:text-gold-deep">Compare all packages + estimate your investment <span aria-hidden="true">→</span></a></p>
  </section>
  <StickyBar />
</Layout>

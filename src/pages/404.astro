---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found — Whatever is Lovely">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="font-script text-6xl text-terra">oops!</p>
    <h1 class="mt-3 font-display text-5xl font-semibold uppercase text-terra">This page eloped</h1>
    <p class="mt-4 leading-relaxed text-ink-soft">The page you're looking for isn't here — it may have moved, or the link may be out of date. Let's get you back to the celebration.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-sm bg-gold px-7 py-3.5 text-sm font-bold uppercase tracking-[0.18em] text-white transition hover:bg-gold-deep">Back Home</a>
      <a href="/work-with-us/" class="rounded-sm border-2 border-terra px-7 py-3.5 text-sm font-bold uppercase tracking-[0.18em] text-terra transition hover:bg-terra hover:text-white">Work With Us</a>
    </div>
  </section>
</Layout>

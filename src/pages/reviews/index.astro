---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import StickyBar from '../../components/StickyBar.astro';
import { reviews, site } from '../../data/site';
const avg = 4.9;
const total = 312;
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
---
<Layout
  title="Reviews — Whatever is Lovely | Kansas City Wedding Planning"
  description="Rated 4.9 out of 5 by 312 Kansas City couples. Read real wedding reviews — full names, wedding dates and venues."
  ogImage="https://whatever-is-lovely.pages.dev/images/couple-sunset-1200.jpg"
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="reveal text-center text-xs font-bold uppercase tracking-[0.35em] text-gold-text">Reviews</p>
    <h1 data-split class="mt-2 text-center font-display text-5xl font-semibold uppercase text-terra sm:text-6xl">Couples say it best</h1>

    <div class="reveal mx-auto mt-8 max-w-xl rounded-2xl border border-line bg-white p-8 text-center shadow-sm">
      <p class="font-display text-6xl font-bold text-terra">{avg}<span class="text-3xl text-ink-soft">/5</span></p>
      <p class="mt-1 text-2xl tracking-wide text-gold-text" aria-label="Rated 4.9 out of 5 stars">{stars(5)}</p>
      <p class="mt-2 text-sm font-semibold text-ink-soft">Average rating from {total} Kansas City couples</p>
      <p class="mt-1 text-xs text-ink-soft/70">Demo reviews — names, dates and venues are mock placeholders for the client presentation.</p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {reviews.map((r) => (
        <article class="reveal rounded-2xl border border-line bg-white p-7 shadow-sm">
          <p class="text-lg tracking-wide text-gold-text" aria-label={`Rated ${r.rating} out of 5 stars`}>{stars(r.rating)}</p>
          <blockquote class="mt-3 font-display text-2xl italic leading-snug text-terra">“{r.quote}”</blockquote>
          <footer class="mt-4 border-t border-line pt-4">
            <p class="font-bold text-terra">{r.name}</p>
            <p class="text-sm text-ink-soft">Married {r.weddingDate} · {r.venue}</p>
            <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-gold-text">Review shared via {r.platform} <span class="font-normal normal-case tracking-normal text-ink-soft/70">(mock label — not a verified posting)</span></p>
          </footer>
        </article>
      ))}
    </div>

    <div class="reveal mt-12 grid gap-4 sm:grid-cols-2">
      <Picture name="couple-sunset" alt="Newlyweds at sunset in Kansas City" sizes="(max-width: 768px) 100vw, 560px" imgClass="aspect-[4/3] w-full rounded-2xl object-cover shadow-md" />
      <Picture name="bridal-party" alt="Bridal party celebrating after the ceremony" sizes="(max-width: 768px) 100vw, 560px" imgClass="aspect-[4/3] w-full rounded-2xl object-cover shadow-md" />
    </div>
    <div class="reveal mt-10 text-center">
      <p class="font-script text-5xl text-terra">ready to be our next five stars?</p>
      <a href="/book/" class="mt-5 inline-block rounded-sm bg-gold px-8 py-4 text-sm font-bold uppercase tracking-[0.18em] text-ink transition hover:bg-terra hover:text-white">Book a Free Consultation</a>
    </div>
  </section>
  <StickyBar />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import { blogPosts } from '../../data/site';
const fmtDate = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Layout title="The Blog — Whatever is Lovely | Kansas City Wedding Planning">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="reveal text-center text-xs font-bold uppercase tracking-[0.35em] text-gold-text">The Blog</p>
    <h1 data-split class="mt-2 text-center font-display text-5xl font-semibold uppercase text-terra sm:text-6xl">Planning notes + real weddings</h1>
    <p class="reveal mx-auto mt-4 max-w-xl text-center leading-relaxed text-ink-soft">Honest advice from ten years of Kansas City weddings — venues, budgets, timelines and the things nobody tells you.</p>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {blogPosts.map((p) => (
        <article class="wedding-card reveal overflow-hidden rounded-2xl bg-white shadow-sm">
          <a href={`/blog/${p.slug}/`}><Picture name={p.img.replace('/images/', '').replace(/-\d+\.jpg$/, '')} alt={p.title} sizes="(max-width: 768px) 100vw, 380px" imgClass="aspect-[16/10] w-full object-cover" /></a>
          <div class="p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-gold-text">{p.category} · {fmtDate(p.date)} · {p.readingTime}</p>
            <h2 class="mt-1 font-display text-xl font-semibold leading-snug text-terra"><a href={`/blog/${p.slug}/`} class="transition hover:text-gold-deep">{p.title}</a></h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{p.excerpt}</p>
            <p class="mt-3 text-xs font-semibold text-ink-soft/70">By {p.author}, {p.authorRole}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

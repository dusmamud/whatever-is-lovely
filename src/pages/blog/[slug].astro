---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import { blogPosts } from '../../data/site';

export function getStaticPaths() {
  return blogPosts.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const post = blogPosts.find((p) => p.slug === slug)!;
const others = blogPosts.filter((p) => p.slug !== slug);
// en-GB day month year, e.g. '8 Nov 2026' — never a raw ISO date on the page.
const fmtDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(post.date + 'T12:00:00'));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  author: { '@type': 'Person', name: post.author, jobTitle: post.authorRole },
  datePublished: post.date,
  dateModified: post.date,
  image: `https://whatever-is-lovely.pages.dev${post.img}`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://whatever-is-lovely.pages.dev/blog/${post.slug}/` },
  publisher: { '@type': 'Organization', name: 'Whatever is Lovely', url: 'https://whatever-is-lovely.pages.dev' },
};
---
<Layout title={post.seoTitle} description={post.excerpt} ogType="article" publishedTime={post.date} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="reveal text-center text-xs font-bold uppercase tracking-[0.35em] text-gold-text">{post.category} · {post.readingTime}</p>
    <h1 data-split class="mt-3 text-center font-display text-4xl font-semibold leading-tight text-terra sm:text-5xl">{post.title}</h1>
    <p class="reveal mt-4 text-center text-sm text-ink-soft">By {post.author}, {post.authorRole} · {fmtDate}</p>
    <div class="reveal mt-8">
      <Picture name={post.img.replace('/images/', '').replace(/-\d+\.jpg$/, '')} alt={post.title} sizes="(max-width: 768px) 100vw, 768px" imgClass="aspect-[16/10] w-full rounded-2xl object-cover shadow-md" />
    </div>
    <div class="reveal mt-8 space-y-5 text-lg leading-relaxed text-ink-soft">
      {post.body.map((para) => (<p>{para}</p>))}
    </div>
    <div class="reveal mt-10 rounded-2xl bg-terra p-7 text-center text-white">
      <p class="font-script text-4xl">let's plan yours</p>
      <p class="mt-2">Want help with your own Kansas City wedding?</p>
      <a href="/work-with-us/" class="mt-4 inline-block rounded-sm bg-gold px-7 py-3 text-sm font-bold uppercase tracking-[0.18em] text-ink transition hover:bg-white hover:text-terra">Work With Us</a>
    </div>
    <h2 class="reveal mt-12 font-display text-3xl font-semibold text-terra">More from the blog</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {others.map((o) => (
        <a href={`/blog/${o.slug}/`} class="reveal block rounded-2xl border border-line bg-white p-5 shadow-sm transition hover:border-gold">
          <p class="text-xs font-bold uppercase tracking-wider text-gold-text">{o.category} · {o.readingTime}</p>
          <h3 class="mt-1 font-display text-xl font-semibold text-terra">{o.title}</h3>
        </a>
      ))}
    </div>
  </article>
</Layout>
